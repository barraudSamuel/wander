rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'apple.com';
    }

    function isValidUid(uid) {
      return uid is string
        && uid.size() >= 1
        && uid.size() <= 128
        && !uid.matches('.*__.*');
    }

    function isValidDisplayName(displayName) {
      return displayName is string
        && displayName.size() >= 1
        && displayName.size() <= 50
        && displayName.matches('.*[^\\s].*');
    }

    function isValidFriendCode(code) {
      // Excludes visually ambiguous I, O, 0, and 1.
      return code is string
        && code.matches('[A-HJ-NP-Z2-9]{10,12}');
    }

    function isValidProfileColorHex(color) {
      return color is string
        && color.matches('^#[0-9A-F]{6}$');
    }

    function hasExactUserFields(data) {
      return data.keys().hasAll([
          'displayName',
          'friendCode',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'displayName',
          'friendCode',
          'createdAt',
          'updatedAt',
          'profileColorHex',
          'deletionRequestedAt'
        ]);
    }

    function isValidUser(data) {
      return hasExactUserFields(data)
        && isValidDisplayName(data.displayName)
        && isValidFriendCode(data.friendCode)
        // profileColorHex remains optional while legacy clients/documents are
        // still in circulation. New clients always write a generated color.
        && (
          !data.keys().hasAny(['profileColorHex'])
          || isValidProfileColorHex(data.profileColorHex)
        )
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (
          !data.keys().hasAny(['deletionRequestedAt'])
          || data.deletionRequestedAt is timestamp
        );
    }

    function accountDeletionIsPending(uid) {
      let profilePath = /databases/$(database)/documents/users/$(uid);
      let profile = get(profilePath);

      return exists(profilePath)
        && profile.data.keys().hasAny(['deletionRequestedAt'])
        && profile.data.deletionRequestedAt is timestamp;
    }

    function friendshipAtHasStatus(friendshipId, uidA, uidB, allowedStatuses) {
      let friendshipPath =
        /databases/$(database)/documents/friendships/$(friendshipId);
      let friendship = get(friendshipPath);

      return exists(friendshipPath)
        && friendship.data.participants is list
        && friendship.data.participants.size() == 2
        && friendship.data.participants.hasAll([uidA, uidB])
        && friendship.data.status is string
        && friendship.data.status in allowedStatuses;
    }

    function usersAreLinked(uidA, uidB, allowedStatuses) {
      return friendshipAtHasStatus(
          uidA + '__' + uidB,
          uidA,
          uidB,
          allowedStatuses
        )
        || friendshipAtHasStatus(
          uidB + '__' + uidA,
          uidA,
          uidB,
          allowedStatuses
        );
    }

    function profileMatchesFriendCode(ownerId, code, displayName) {
      let profilePath = /databases/$(database)/documents/users/$(ownerId);
      let profile = getAfter(profilePath);

      return existsAfter(profilePath)
        && profile.data.friendCode == code
        && profile.data.displayName == displayName;
    }

    function friendCodeMatchesProfile(code, ownerId, displayName) {
      let friendCodePath =
        /databases/$(database)/documents/friendCodes/$(code);
      let friendCode = getAfter(friendCodePath);

      return existsAfter(friendCodePath)
        && friendCode.data.ownerId == ownerId
        && friendCode.data.displayName == displayName;
    }

    function hasExactFriendCodeFields(data) {
      return data.keys().hasAll([
          'ownerId',
          'displayName',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'displayName',
          'createdAt'
        ]);
    }

    function isValidFriendCodeDocument(data, code) {
      return hasExactFriendCodeFields(data)
        && isValidUid(data.ownerId)
        && isValidDisplayName(data.displayName)
        && data.createdAt is timestamp
        && isValidFriendCode(code);
    }

    function hasExactPendingFriendshipFields(data) {
      return data.keys().hasAll([
          'participants',
          'requestedBy',
          'status',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'participants',
          'requestedBy',
          'status',
          'createdAt'
        ]);
    }

    function hasExactAcceptedFriendshipFields(data) {
      return data.keys().hasAll([
          'participants',
          'requestedBy',
          'status',
          'createdAt',
          'acceptedAt'
        ])
        && data.keys().hasOnly([
          'participants',
          'requestedBy',
          'status',
          'createdAt',
          'acceptedAt'
        ]);
    }

    function isValidPair(data, pairId) {
      return data.participants is list
        && data.participants.size() == 2
        && isValidUid(data.participants[0])
        && isValidUid(data.participants[1])
        && data.participants[0] < data.participants[1]
        && pairId
          == data.participants[0] + '__' + data.participants[1]
        && data.requestedBy is string
        && data.requestedBy in data.participants;
    }

    function isValidPendingFriendship(data, pairId) {
      return hasExactPendingFriendshipFields(data)
        && isValidPair(data, pairId)
        && data.status == 'pending'
        && data.createdAt is timestamp;
    }

    function isValidAcceptedFriendship(data, pairId) {
      return hasExactAcceptedFriendshipFields(data)
        && isValidPair(data, pairId)
        && data.status == 'accepted'
        && data.createdAt is timestamp
        && data.acceptedAt is timestamp;
    }

    function pairIdNamesCurrentUser(pairId) {
      let uid = request.auth.uid;
      let prefixLength = uid.size() + 2;
      let suffixLength = uid.size() + 2;

      return pairId.size() > prefixLength
        && (
          pairId[0:prefixLength] == uid + '__'
          || pairId[pairId.size() - suffixLength:pairId.size()]
            == '__' + uid
        );
    }

    function hasExactLocationFields(data) {
      return data.keys().hasAll([
        'location',
        'displayName',
        'horizontalAccuracy',
        'sampledAt',
        'updatedAt'
      ])
        && data.keys().hasOnly([
          'location',
          'displayName',
          'horizontalAccuracy',
          'sampledAt',
          'updatedAt',
          'spotEnteredAt',
          'h3CellId',
          'h3EnteredAt'
        ]);
    }

    function isValidH3CellId(cellId) {
      return cellId is string
        && cellId.matches('^[0-9a-f]{15}$');
    }

    function hasValidLocationPresence(data) {
      let hasSpotEnteredAt = data.keys().hasAny(['spotEnteredAt']);
      let hasLegacyPresence =
        data.keys().hasAny(['h3CellId', 'h3EnteredAt']);

      return (!hasSpotEnteredAt && !hasLegacyPresence)
        || (
          hasSpotEnteredAt
          && !hasLegacyPresence
          && data.spotEnteredAt is timestamp
          && data.spotEnteredAt <= data.sampledAt
        )
        || (
          !hasSpotEnteredAt
          && data.keys().hasAll(['h3CellId', 'h3EnteredAt'])
          && isValidH3CellId(data.h3CellId)
          && data.h3EnteredAt is timestamp
          && data.h3EnteredAt <= data.sampledAt
        );
    }

    function isValidLocation(data) {
      return hasExactLocationFields(data)
        && data.location is latlng
        && data.location.latitude() >= -90
        && data.location.latitude() <= 90
        && data.location.longitude() >= -180
        && data.location.longitude() <= 180
        && isValidDisplayName(data.displayName)
        && data.horizontalAccuracy is number
        && data.horizontalAccuracy > 0
        && data.horizontalAccuracy <= 1000
        && data.sampledAt is timestamp
        && data.sampledAt > request.time - duration.value(5, 'm')
        && data.sampledAt <= request.time + duration.value(1, 'm')
        && data.updatedAt is timestamp
        && data.updatedAt == request.time
        && hasValidLocationPresence(data);
    }

    function isValidExplorationCell(data, cellId) {
      return isValidH3CellId(cellId)
        && data.keys().hasAll(['sharedAt'])
        && data.keys().hasOnly(['sharedAt'])
        && data.sharedAt is timestamp
        && data.sharedAt == request.time;
    }

    function hasExactPlanFields(data) {
      return data.keys().hasAll([
          'ownerId',
          'publicationId',
          'displayName',
          'placeName',
          'location',
          'plannedAt',
          'expiresAt',
          'publishedAt',
          'updatedAt',
          'timeZoneIdentifier'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'publicationId',
          'displayName',
          'placeName',
          'address',
          'location',
          'plannedAt',
          'expiresAt',
          'publishedAt',
          'updatedAt',
          'timeZoneIdentifier'
        ]);
    }

    function isValidPublicationId(publicationId) {
      return publicationId is string
        && publicationId.matches(
          '^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$'
        );
    }

    function isNormalizedPlanText(value) {
      return value is string
        && value.matches('^[^\\s]+( [^\\s]+)*$');
    }

    function isValidPlaceName(placeName) {
      return isNormalizedPlanText(placeName)
        && placeName.size() >= 1
        && placeName.size() <= 120;
    }

    function isValidPlanAddress(data) {
      return !data.keys().hasAny(['address'])
        || (
          data.address is string
          && data.address.size() >= 1
          && data.address.size() <= 200
          && isNormalizedPlanText(data.address)
        );
    }

    function isValidTimeZoneIdentifier(identifier) {
      // Full IANA membership is validated by Foundation on the client. Rules
      // still constrain the identifier to the IANA path character set.
      return identifier is string
        && identifier.size() >= 1
        && identifier.size() <= 64
        && identifier.matches(
          '^[A-Za-z0-9._+-]+(/[A-Za-z0-9._+-]+)*$'
        );
    }

    function isValidPlan(data, uid) {
      return hasExactPlanFields(data)
        && data.ownerId == uid
        && isValidUid(data.ownerId)
        && isValidPublicationId(data.publicationId)
        && isValidDisplayName(data.displayName)
        && isNormalizedPlanText(data.displayName)
        && isValidPlaceName(data.placeName)
        && isValidPlanAddress(data)
        && data.location is latlng
        && data.location.latitude() >= -90
        && data.location.latitude() <= 90
        && data.location.longitude() >= -180
        && data.location.longitude() <= 180
        && data.plannedAt is timestamp
        && data.plannedAt > request.time
        && data.plannedAt <= request.time + duration.value(24, 'h')
        && data.expiresAt is timestamp
        && data.expiresAt > data.plannedAt
        && data.expiresAt <= data.plannedAt + duration.value(2, 'h')
        && data.publishedAt is timestamp
        && data.publishedAt == request.time
        && data.updatedAt is timestamp
        && data.updatedAt == request.time
        && isValidTimeZoneIdentifier(data.timeZoneIdentifier);
    }

    match /users/{uid} {
      allow get: if isSignedIn()
        && (
          request.auth.uid == uid
          || usersAreLinked(
            request.auth.uid,
            uid,
            ['pending', 'accepted']
          )
        );
      allow list: if false;

      allow create: if isSignedIn()
        && request.auth.uid == uid
        && isValidUser(request.resource.data)
        && request.resource.data.keys().hasAll(['profileColorHex'])
        && !request.resource.data.keys().hasAny(['deletionRequestedAt'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && friendCodeMatchesProfile(
          request.resource.data.friendCode,
          uid,
          request.resource.data.displayName
        );

      allow update: if isSignedIn()
        && request.auth.uid == uid
        && isValidUser(request.resource.data)
        && request.resource.data.friendCode == resource.data.friendCode
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && (
          (
            !resource.data.keys().hasAny(['deletionRequestedAt'])
            && !request.resource.data.keys().hasAny(['deletionRequestedAt'])
            && (
              !resource.data.keys().hasAny(['profileColorHex'])
              || request.resource.data.keys().hasAll(['profileColorHex'])
            )
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['displayName', 'profileColorHex', 'updatedAt'])
            && friendCodeMatchesProfile(
              request.resource.data.friendCode,
              uid,
              request.resource.data.displayName
            )
          )
          || (
            !resource.data.keys().hasAny(['deletionRequestedAt'])
            && request.resource.data.keys().hasAll(['deletionRequestedAt'])
            && request.resource.data.deletionRequestedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['deletionRequestedAt', 'updatedAt'])
          )
        );

      // Profile and code are deleted together so a code can never be claimed
      // while an older profile still references it.
      allow delete: if isSignedIn()
        && request.auth.uid == uid
        && resource.data.keys().hasAny(['deletionRequestedAt'])
        && resource.data.deletionRequestedAt is timestamp
        && isValidFriendCode(resource.data.friendCode)
        && !existsAfter(
          /databases/$(database)/documents/friendCodes/$(resource.data.friendCode)
        );
    }

    match /friendCodes/{code} {
      allow get: if isSignedIn() && isValidFriendCode(code);
      allow list: if false;

      allow create: if isSignedIn()
        && isValidFriendCodeDocument(request.resource.data, code)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && profileMatchesFriendCode(
          request.auth.uid,
          code,
          request.resource.data.displayName
        );

      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && isValidFriendCodeDocument(request.resource.data, code)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName'])
        && profileMatchesFriendCode(
          request.auth.uid,
          code,
          request.resource.data.displayName
        );

      allow delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && !existsAfter(
          /databases/$(database)/documents/users/$(resource.data.ownerId)
        );
    }

    match /friendships/{pairId} {
      // Existing documents remain participant-only. The second branch permits a
      // participant to read a deterministic pair path while checking that it is
      // still absent immediately before a transactional create.
      allow get: if isSignedIn()
        && (
          (
            exists(
              /databases/$(database)/documents/friendships/$(pairId)
            )
            && request.auth.uid in resource.data.participants
          )
          || (
            !exists(
              /databases/$(database)/documents/friendships/$(pairId)
            )
            && pairIdNamesCurrentUser(pairId)
          )
        );

      // A where("participants", arrayContains: currentUid) query proves this
      // condition for every possible result; an unfiltered collection read does
      // not.
      allow list: if isSignedIn()
        && request.auth.uid in resource.data.participants;

      allow create: if isSignedIn()
        && isValidPendingFriendship(request.resource.data, pairId)
        && request.resource.data.requestedBy == request.auth.uid
        && request.auth.uid in request.resource.data.participants
        && !accountDeletionIsPending(request.resource.data.participants[0])
        && !accountDeletionIsPending(request.resource.data.participants[1])
        && request.resource.data.createdAt == request.time;

      allow update: if isSignedIn()
        && isValidPendingFriendship(resource.data, pairId)
        && isValidAcceptedFriendship(request.resource.data, pairId)
        && request.auth.uid in resource.data.participants
        && request.auth.uid != resource.data.requestedBy
        && !accountDeletionIsPending(resource.data.participants[0])
        && !accountDeletionIsPending(resource.data.participants[1])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'acceptedAt'])
        && request.resource.data.acceptedAt == request.time;

      allow delete: if isSignedIn()
        && (
          (
            isValidPendingFriendship(resource.data, pairId)
            && request.auth.uid in resource.data.participants
          )
          || (
            isValidAcceptedFriendship(resource.data, pairId)
            && request.auth.uid in resource.data.participants
          )
        );
    }

    match /locations/{uid} {
      allow get: if isSignedIn()
        && (
          request.auth.uid == uid
          || usersAreLinked(
            request.auth.uid,
            uid,
            ['accepted']
          )
        );
      allow list: if false;

      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && !accountDeletionIsPending(uid)
        && isValidLocation(request.resource.data);

      allow delete: if isSignedIn()
        && request.auth.uid == uid;
    }

    match /explorations/{uid}/cells/{cellId} {
      allow get, list: if isSignedIn()
        && (
          request.auth.uid == uid
          || usersAreLinked(
            request.auth.uid,
            uid,
            ['accepted']
          )
        );

      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && !accountDeletionIsPending(uid)
        && isValidExplorationCell(request.resource.data, cellId);

      allow delete: if isSignedIn()
        && request.auth.uid == uid;
    }

    match /plans/{uid} {
      allow get: if isSignedIn()
        && (
          request.auth.uid == uid
          || (
            resource.data.expiresAt is timestamp
            && resource.data.expiresAt > request.time
            && usersAreLinked(
              request.auth.uid,
              uid,
              ['accepted']
            )
          )
        );
      allow list: if false;

      allow create: if isSignedIn()
        && request.auth.uid == uid
        && !accountDeletionIsPending(uid)
        && isValidPlan(request.resource.data, uid);

      allow update: if isSignedIn()
        && request.auth.uid == uid
        && !accountDeletionIsPending(uid)
        && isValidPlan(request.resource.data, uid)
        && request.resource.data.publicationId != resource.data.publicationId;

      allow delete: if isSignedIn()
        && request.auth.uid == uid;
    }

    // Any collection or subcollection not explicitly listed above is private.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
