rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function friendshipAtHasStatus(friendshipId, uidA, uidB, status) {
      let friendshipPath =
        /databases/$(database)/documents/friendships/$(friendshipId);
      let friendship = get(friendshipPath);

      return exists(friendshipPath)
        && friendship.data.participants is list
        && friendship.data.participants.size() == 2
        && friendship.data.participants.hasAll([uidA, uidB])
        && friendship.data.status == status;
    }

    function usersHaveFriendshipStatus(uidA, uidB, status) {
      return friendshipAtHasStatus(
          uidA + '__' + uidB,
          uidA,
          uidB,
          status
        )
        || friendshipAtHasStatus(
          uidB + '__' + uidA,
          uidA,
          uidB,
          status
        );
    }

    function canReadProfile(uid) {
      return request.auth.uid == uid
        || usersHaveFriendshipStatus(
          request.auth.uid,
          uid,
          'pending'
        )
        || usersHaveFriendshipStatus(
          request.auth.uid,
          uid,
          'accepted'
        );
    }

    function canReadSocialData(uid) {
      return request.auth.uid == uid
        || usersHaveFriendshipStatus(
          request.auth.uid,
          uid,
          'accepted'
        );
    }

    function eventExists(ownerId, eventId) {
      return exists(
        /databases/$(database)/documents/users/$(ownerId)/events/$(eventId)
      );
    }

    function pairMatchesData(data, pairId) {
      return data.participants is list
        && data.participants.size() == 2
        && data.participants[0] < data.participants[1]
        && pairId
          == data.participants[0] + '__' + data.participants[1]
        && data.requestedBy in data.participants;
    }

    function pairIdNamesCurrentUser(pairId) {
      let uid = request.auth.uid;
      let prefixLength = uid.size() + 2;
      let suffixLength = uid.size() + 2;

      return pairId.size() > prefixLength
        && (
          pairId[0:prefixLength] == uid + '__'
          || pairId[pairId.size() - suffixLength:pairId.size()]
            == '__' + uid
        );
    }

    function friendshipIdentityIsUnchanged() {
      return request.resource.data.participants == resource.data.participants
        && request.resource.data.requestedBy == resource.data.requestedBy
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function accountDeletionIsPending(uid) {
      let profilePath = /databases/$(database)/documents/users/$(uid);
      let profile = get(profilePath);

      return exists(profilePath)
        && profile.data.keys().hasAny(['deletionRequestedAt']);
    }

    match /users/{uid} {
      allow get: if isSignedIn() && canReadProfile(uid);
      allow list: if false;
      allow create, update, delete: if isSignedIn()
        && request.auth.uid == uid;

      match /devices/{deviceId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }

      match /locationPushDevices/{deviceId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    match /friendCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    match /friendships/{pairId} {
      allow get: if isSignedIn()
        && (
          (
            exists(
              /databases/$(database)/documents/friendships/$(pairId)
            )
            && request.auth.uid in resource.data.participants
          )
          || (
            !exists(
              /databases/$(database)/documents/friendships/$(pairId)
            )
            && pairIdNamesCurrentUser(pairId)
          )
        );

      allow list: if isSignedIn()
        && request.auth.uid in resource.data.participants;

      allow create: if isSignedIn()
        && pairMatchesData(request.resource.data, pairId)
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending';

      allow update: if isSignedIn()
        && pairMatchesData(resource.data, pairId)
        && pairMatchesData(request.resource.data, pairId)
        && friendshipIdentityIsUnchanged()
        && request.auth.uid in resource.data.participants
        && (
          (
            resource.data.status == 'pending'
            && request.resource.data.status == 'accepted'
            && request.auth.uid != resource.data.requestedBy
          )
          || (
            resource.data.status == 'accepted'
            && request.resource.data.status == 'revoking'
          )
        );

      allow delete: if isSignedIn()
        && pairMatchesData(resource.data, pairId)
        && request.auth.uid in resource.data.participants
        && (
          resource.data.status == 'pending'
          || accountDeletionIsPending(request.auth.uid)
        );
    }

    match /locations/{uid} {
      allow get: if isSignedIn() && canReadSocialData(uid);
      allow list: if false;
      allow create, update, delete: if isSignedIn()
        && request.auth.uid == uid;
    }

    match /locationPushDispatches/{uid} {
      allow get, list, create, update: if false;
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    match /explorations/{uid}/cells/{cellId} {
      allow get, list: if isSignedIn() && canReadSocialData(uid);
      allow create, update, delete: if isSignedIn()
        && request.auth.uid == uid;
    }

    match /users/{ownerId}/events/{eventId} {
      allow get, list: if isSignedIn() && canReadSocialData(ownerId);
      allow create, update, delete: if isSignedIn()
        && request.auth.uid == ownerId;

      match /attendees/{attendanceId} {
        allow get: if isSignedIn()
          && (
            canReadSocialData(ownerId)
            || request.auth.uid == resource.data.participantId
          );
        allow list: if isSignedIn() && canReadSocialData(ownerId);
        allow create: if isSignedIn()
          && eventExists(ownerId, eventId)
          && request.auth.uid != ownerId
          && request.resource.data.participantId == request.auth.uid
          && usersHaveFriendshipStatus(
            request.auth.uid,
            ownerId,
            'accepted'
          );
        allow update: if isSignedIn()
          && eventExists(ownerId, eventId)
          && request.auth.uid == resource.data.participantId
          && request.resource.data.participantId == request.auth.uid
          && usersHaveFriendshipStatus(
            request.auth.uid,
            ownerId,
            'accepted'
          );
        allow delete: if isSignedIn()
          && (
            request.auth.uid == ownerId
            || (
              exists(
                /databases/$(database)/documents/users/$(ownerId)/events/$(eventId)/attendees/$(attendanceId)
              )
              && request.auth.uid == resource.data.participantId
            )
            || (
              !exists(
                /databases/$(database)/documents/users/$(ownerId)/events/$(eventId)/attendees/$(attendanceId)
              )
              && eventExists(ownerId, eventId)
              && usersHaveFriendshipStatus(
                request.auth.uid,
                ownerId,
                'accepted'
              )
            )
          );
      }

      match /declines/{declineId} {
        allow get: if isSignedIn()
          && (
            canReadSocialData(ownerId)
            || request.auth.uid == resource.data.participantId
          );
        allow list: if isSignedIn() && canReadSocialData(ownerId);
        allow create: if isSignedIn()
          && eventExists(ownerId, eventId)
          && request.auth.uid != ownerId
          && request.resource.data.participantId == request.auth.uid
          && usersHaveFriendshipStatus(
            request.auth.uid,
            ownerId,
            'accepted'
          );
        allow update: if isSignedIn()
          && eventExists(ownerId, eventId)
          && request.auth.uid == resource.data.participantId
          && request.resource.data.participantId == request.auth.uid
          && usersHaveFriendshipStatus(
            request.auth.uid,
            ownerId,
            'accepted'
          );
        allow delete: if isSignedIn()
          && (
            request.auth.uid == ownerId
            || (
              exists(
                /databases/$(database)/documents/users/$(ownerId)/events/$(eventId)/declines/$(declineId)
              )
              && request.auth.uid == resource.data.participantId
            )
            || (
              !exists(
                /databases/$(database)/documents/users/$(ownerId)/events/$(eventId)/declines/$(declineId)
              )
              && eventExists(ownerId, eventId)
              && usersHaveFriendshipStatus(
                request.auth.uid,
                ownerId,
                'accepted'
              )
            )
          );
      }
    }

    match /{path=**}/attendees/{attendanceId} {
      allow list: if isSignedIn()
        && request.auth.uid == resource.data.participantId;
    }

    match /{path=**}/declines/{declineId} {
      allow list: if isSignedIn()
        && request.auth.uid == resource.data.participantId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
